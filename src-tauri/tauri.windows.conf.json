{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "bun scripts/prepare-windows-host.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "KWork",
        "width": 1200,
        "height": 800,
        "center": true,
        "resizable": true,
        "maximizable": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../services/account-platform-electron/bundle/": "account-platform/",
      "../services/windows-host/bundle/": "harness-runtime/"
    }
  }
}
